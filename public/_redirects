# Netlify 301 redirects for legacy pages
# Destinations use trailing slash to match site canonical form and skip
# Netlify's slash-enforcer second hop.
/process  /how-we-work/  301
/projects  /portfolio/  301
/services/long-term-projects  /services/full-project-delivery/  301
/dotnet-development-company  /hire-dotnet-developer/  301

# Blog cannibalization fix — consolidate legacy freelancer-vs-agency post into
# the stronger, fully-optimized version (same query, kept the better article).
/blog/hire-freelancer-or-agency-for-business  /blog/freelancer-vs-agency-software-development/  301

# AI service lines moved under /services/ (founder decision). These old root
# paths were branch-only and never deployed/indexed — 301s here purely as a
# safety net so any stray link resolves to the canonical /services/ URL.
/ai-development-services  /services/ai-development/  301
/ai-agent-development  /services/ai-agent-development/  301
/vibe-code-rescue  /services/ai-app-rescue/  301

# Retired v2 pages — collapse to homepage to preserve any latent equity
/old-v2/*  /  301

# Legacy /technologies/* pages. These were collapsing to the homepage via a
# wildcard, which Google treats as a soft 404 for an irrelevant destination: the
# ranking signal is discarded rather than preserved. Several of these URLs are
# still indexed and still earning impressions (dotnet pos 8.9, reactjs pos 9.3,
# angular pos 1.0), so each now points at the hire page that actually matches it.
# Netlify is first-match-wins, so these specific rules must stay ABOVE the wildcard.
/technologies/dotnet          /hire-dotnet-developer/        301
/technologies/vuejs           /hire-vuejs-developer/         301
/technologies/reactjs         /hire-react-developer/         301
/technologies/react           /hire-react-developer/         301
/technologies/angular         /hire-angular-developer/       301
/technologies/ruby-on-rails   /hire-rails-developer/         301
/technologies/rails           /hire-rails-developer/         301
/technologies/nodejs          /hire-nodejs-developer/        301
/technologies/node            /hire-nodejs-developer/        301
/technologies/python          /hire-python-developer/        301
/technologies/django          /hire-django-developer/        301
/technologies/flutter         /hire-flutter-developer/       301
/technologies/react-native    /hire-react-native-developer/  301
/technologies/nuxt            /hire-nuxt-developer/          301
/technologies/nuxtjs          /hire-nuxt-developer/          301

# Anything else under /technologies/ has no obvious 1:1 match, so the services
# index is a closer fit than the homepage.
/technologies/*  /services/  301
